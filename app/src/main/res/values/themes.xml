<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.SudarshanGuard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorPrimaryVariant">@color/accent_amber_dark</item>
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialButtonStyle">@style/SudarshanButton</item>
    </style>

    <style name="Theme.SudarshanGuard.Splash" parent="Theme.SudarshanGuard">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="SudarshanButton" parent="Widget.Material3.Button">
        <item name="android:fontFamily">monospace</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

</resources>
